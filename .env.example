# ---------------------------------------------------------------------------
# Masaken Aljafil — environment variables
# Copy to .env (never commit .env). All secrets are read on the server only.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required in production; `npm run dev` without it
# starts a bundled local database). On Supabase + Vercel use the Transaction
# pooler (port 6543) and append ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aljafil

# Direct / Session-pooler connection (port 5432) used by `npm run build` to apply
# migrations + seed automatically on deploy. Optional elsewhere.
DIRECT_URL=

# One-time secret for the first-admin page /admin/setup (required in production).
SETUP_KEY=

# Public absolute URL of the site, no trailing slash. Used for canonical URLs,
# hreflang, sitemap.xml and Open Graph. (required in production)
NEXT_PUBLIC_SITE_URL=https://aljafil.com

# Media storage. With these two set, uploads go to Supabase Storage (required on
# Vercel/serverless). Use the Secret key (sb_secret_...), never the publishable one.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# Otherwise uploads are stored on local disk here (needs a persistent volume).
STORAGE_DIR=./storage/uploads

# --- Team notifications (optional) -----------------------------------------
# Incoming-webhook URL (Slack / Microsoft Teams / Google Chat / internal).
# Receives a short alert with a dashboard link; no customer data is sent.
NOTIFY_WEBHOOK_URL=

# --- AI property assistant (optional) ---------------------------------------
# Without a key the assistant still works with guided questions + database
# matching. With a key, Claude interprets free text and phrases replies that
# are grounded in the retrieved records.
ANTHROPIC_API_KEY=
# Model used by the assistant (default: claude-opus-5-5).
# claude-haiku-5-5 is a much cheaper option for this workload.
ASSISTANT_MODEL=

# --- Google reporting (optional) --------------------------------------------
# Service account used server-side to read Search Console & GA4 reports.
# Public IDs (GA4 / GTM / Search Console property) are set in the dashboard.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- One-off: used by `npm run admin:create` instead of the hidden prompt ----
# ADMIN_PASSWORD=
